# Copy to .env.local for local dev, and add the same keys in Vercel → Settings → Environment Variables.
# Never commit real values — .env* files are gitignored.

# Public (bundled into the browser; safe to expose, protected by Supabase RLS)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SITE_URL=https://rohit-gayathiri.vercel.app

# Server-only secrets (used by /api functions on Vercel — never prefix with VITE_)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GMAIL_USER=
GMAIL_APP_PASSWORD=
SITE_URL=https://rohit-gayathiri.vercel.app
CRON_SECRET=
