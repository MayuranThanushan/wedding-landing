{
  "redirects": [
    {
      "source": "/rsvp.html",
      "destination": "/engagement/",
      "permanent": false
    },
    {
      "source": "/engagement/rsvp.html",
      "destination": "/engagement/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|engagement/|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron-reminders",
      "schedule": "30 3 * * *"
    }
  ]
}
