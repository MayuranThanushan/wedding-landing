# ---- Browser (exposed to the site; safe to be public) ----
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ---- Server only (Vercel → Settings → Environment Variables; never prefix with VITE_) ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Gmail account used to send emails + a Google "App password" (Google Account → Security → App passwords)
GMAIL_USER=rohitgayathiri1803@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# Any long random string; Vercel sends it to the cron endpoint automatically
CRON_SECRET=change-me-to-a-long-random-string
# Public site URL used in email links
SITE_URL=https://rohit-gayathiri.vercel.app
